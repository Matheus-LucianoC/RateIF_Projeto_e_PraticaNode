# MySQL (ajuste usuário/senha para o seu ambiente; não use valores de exemplo em produção)
DB_URL=mysql://localhost:3306/sistema_escolar
DB_USERNAME=root
DB_PASSWORD=root123
SERVER_PORT=8080

# Segredo de JWT mobile: gere um valor aleatório com no mínimo 32 caracteres. Obrigatório em produção.
MOBILE_JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32-caracteres
MOBILE_JWT_EXPIRATION_HOURS=8
# Sessão web: encerra após inatividade e possui limite absoluto de duração.
WEB_SESSION_IDLE_MINUTES=30
WEB_SESSION_MAX_HOURS=12
# Mobile: refresh token rotativo, com expiração deslizante e limite absoluto.
MOBILE_REFRESH_DAYS=30
MOBILE_REFRESH_MAX_DAYS=90
# Use true quando a aplicação estiver publicada atrás de HTTPS.
SESSION_COOKIE_SECURE=false

# Integração Google opcional e bootstrap de administrador (somente configure explicitamente).
GOOGLE_CLIENT_ID=
RATEIF_ADMIN_EMAIL=
RATEIF_ADMIN_PASSWORD=
RATEIF_ADMIN_NAME=Administrador RateIF
